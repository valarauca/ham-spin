import Spin.Reduce
import Mathlib.Algebra.FreeAlgebra
import Mathlib.RingTheory.Congruence.Hom
import Mathlib.Tactic.LinearCombination
import Mathlib.Tactic.Module

/-!
# Temperley–Lieb algebras and the Jones–Wenzl form of the three-cycle relation (COD-278)

Theorem B.1 and B.2 of `results/presentation-consequences-extend.md` §3.1 (organize-archive
3ba2201), with the corrections of items 8 and 9 of `results/presentation-consequences-factcheck-
extend.md` (3ba2201). The crossing `s_i = 1 + e_i` at `δ = -2` is steps 1 and 1b of
`results/tl-jantzen-extend.md` (b21b41a). Mathlib v4.35.0 has no Temperley–Lieb algebra, so it is
built here as a quotient of a free algebra.

* `TL R N δ`, the Temperley–Lieb algebra `TL_N(δ)` on `N` strands over a commutative ring `R`,
  with generators `TL.e i` for `i : Fin (N - 1)`. `TL.lift` is its universal property and
  `TL.hom_ext` its uniqueness.
* `jw δ x y = 1 - (δ / (δ² - 1)) (x + y) + (1 / (δ² - 1)) (x y + y x)`, the Jones–Wenzl
  element on three strands, defined whenever `δ² - 1` is a unit.
* Theorem B.1. `TL.e_mul_jw`, `TL.jw_mul_e`, `TL.e_mul_jw'`, `TL.jw_mul_e'` : `e_i f = f e_i = 0`
  for both generators, and `TL.jw_mul_self` : `f² = f`. `TL.f3` is `f_3` in `TL_3(δ)`.
  `TL.one_add_s_mul_s_add_s_mul_s` : at `δ = -2`, `1 + s_1 s_2 + s_2 s_1 = 3 f_3` over any ring
  where `3` is a unit. `TL.f3_F₂` : over `𝔽₂` at `δ = 0`, `f_3 = 1 + e_1 e_2 + e_2 e_1`.
* Theorem B.2. `TLJW n` is `TL_2n(0) ⧸ ⟨f_3^(i)⟩` over `𝔽₂`, the quotient by every translate
  `f_3^(i)` on strands `i, i+1, i+2`. `TL.jwQuotEquivCl` : `TLJW n ≃ₐ Cl(U_n, q)` with
  `e_i ↦ 1 + ι(v_{i,i+1})`, from `reduceHom` and `TL.lift`.

The paper's ideal `⟨f_3⟩` is generated by `f_3 = f_3^(0)` alone. It contains every translate,
since `f_3^(i+1) = w f_3^(i) w⁻¹` for `w = s_i s_(i+1) s_(i+2)`, a unit of `TL_2n(0)` over `𝔽₂`
(fact check item 9). The quotient here uses all translates as generators.
-/

namespace Pairing

open PerfectMatching

namespace TL

variable (R : Type*) [CommRing R] (N : ℕ) (δ : R)

/-- The defining relations of `TL_N(δ)` on the free algebra over the generators `e_i`,
`i < N - 1`: `e_i² = δ e_i`, `e_i e_j e_i = e_i` for `|i - j| = 1`, and `e_i e_j = e_j e_i` for
`|i - j| ≥ 2` (`results/presentation-consequences-extend.md` §3.1, 3ba2201). -/
inductive Rel : FreeAlgebra R (Fin (N - 1)) → FreeAlgebra R (Fin (N - 1)) → Prop
  | sq (i : Fin (N - 1)) : Rel (FreeAlgebra.ι R i * FreeAlgebra.ι R i) (δ • FreeAlgebra.ι R i)
  | braid (i j : Fin (N - 1)) (h : (j : ℕ) = i + 1 ∨ (i : ℕ) = j + 1) :
      Rel (FreeAlgebra.ι R i * FreeAlgebra.ι R j * FreeAlgebra.ι R i) (FreeAlgebra.ι R i)
  | comm (i j : Fin (N - 1)) (h : (i : ℕ) + 2 ≤ j) :
      Rel (FreeAlgebra.ι R i * FreeAlgebra.ι R j) (FreeAlgebra.ι R j * FreeAlgebra.ι R i)

/-- `Rel` as a ring congruence on the free algebra. -/
def ringCon : RingCon (FreeAlgebra R (Fin (N - 1))) :=
  ringConGen (Rel R N δ)

end TL

/-- The Temperley–Lieb algebra `TL_N(δ)` on `N` strands over `R`, the quotient of the free
algebra on `e_1, …, e_(N-1)` by `TL.Rel` (`results/presentation-consequences-extend.md` §3.1,
3ba2201). It is built like Mathlib's `CliffordAlgebra`, as a `RingCon.Quotient`. -/
def TL (R : Type*) [CommRing R] (N : ℕ) (δ : R) : Type _ :=
  (TL.ringCon R N δ).Quotient

namespace TL

variable {R : Type*} [CommRing R] {N : ℕ} {δ : R}

/-- The ring structure of `TL_N(δ)`, from the quotient. -/
instance : Ring (TL R N δ) :=
  inferInstanceAs (Ring (RingCon.Quotient _))

/-- The `R`-algebra structure of `TL_N(δ)`, from the quotient. -/
instance : Algebra R (TL R N δ) :=
  inferInstanceAs (Algebra R (RingCon.Quotient _))

variable (R N δ) in
/-- The quotient map `R⟨e_1, …, e_(N-1)⟩ → TL_N(δ)`. -/
def mk : FreeAlgebra R (Fin (N - 1)) →ₐ[R] TL R N δ :=
  RingCon.mkₐ R (ringCon R N δ)

variable (R N δ) in
/-- The generator `e_i` of `TL_N(δ)`, for `i < N - 1`. -/
def e (i : Fin (N - 1)) : TL R N δ :=
  mk R N δ (FreeAlgebra.ι R i)

/-- Related elements of the free algebra have the same image in `TL_N(δ)`. -/
theorem mk_rel {x y : FreeAlgebra R (Fin (N - 1))} (h : Rel R N δ x y) : mk R N δ x = mk R N δ y :=
  (RingCon.eq _).mpr (RingCon.le_ringConGen _ _ h)

/-- `e_i² = δ e_i`. -/
theorem e_mul_self (i : Fin (N - 1)) : e R N δ i * e R N δ i = δ • e R N δ i := by
  rw [e, ← map_mul, ← map_smul]
  exact mk_rel (Rel.sq i)

/-- `e_i e_j e_i = e_i` for `|i - j| = 1`. -/
theorem e_mul_e_mul_e {i j : Fin (N - 1)} (h : (j : ℕ) = i + 1 ∨ (i : ℕ) = j + 1) :
    e R N δ i * e R N δ j * e R N δ i = e R N δ i := by
  rw [e, e, ← map_mul, ← map_mul]
  exact mk_rel (Rel.braid i j h)

/-- `e_i e_j = e_j e_i` for `|i - j| ≥ 2`. -/
theorem e_mul_e_comm {i j : Fin (N - 1)} (h : (i : ℕ) + 2 ≤ j ∨ (j : ℕ) + 2 ≤ i) :
    e R N δ i * e R N δ j = e R N δ j * e R N δ i := by
  rw [e, e, ← map_mul, ← map_mul]
  rcases h with h | h
  · exact mk_rel (Rel.comm i j h)
  · exact (mk_rel (Rel.comm j i h)).symm

section Lift

variable {A : Type*} [Ring A] [Algebra R A]

/-- The universal property of `TL_N(δ)`: elements `f_i` of an `R`-algebra satisfying the
Temperley–Lieb relations define `TL_N(δ) → A` with `e_i ↦ f_i`. -/
def lift (f : Fin (N - 1) → A) (h1 : ∀ i, f i * f i = δ • f i)
    (h2 : ∀ i j : Fin (N - 1), ((j : ℕ) = i + 1 ∨ (i : ℕ) = j + 1) → f i * f j * f i = f i)
    (h3 : ∀ i j : Fin (N - 1), (i : ℕ) + 2 ≤ j → f i * f j = f j * f i) : TL R N δ →ₐ[R] A :=
  RingCon.liftₐ (ringCon R N δ) (FreeAlgebra.lift R f) (RingCon.ringConGen_le.2 fun x y h ↦ by
    rw [RingCon.ker_apply]
    induction h with
    | sq i => simp [h1]
    | braid i j h => simp [h2 i j h]
    | comm i j h => simp [h3 i j h])

/-- `lift f (e_i) = f_i`. -/
@[simp]
theorem lift_e (f : Fin (N - 1) → A) (h1 h2 h3) (i : Fin (N - 1)) :
    lift f h1 h2 h3 (e R N δ i) = f i :=
  FreeAlgebra.lift_ι_apply _ _

/-- Two algebra maps out of `TL_N(δ)` that agree on every `e_i` are equal. -/
theorem hom_ext {g g' : TL R N δ →ₐ[R] A} (h : ∀ i, g (e R N δ i) = g' (e R N δ i)) : g = g' :=
  RingCon.Quotient.hom_extₐ (FreeAlgebra.hom_ext (funext h))

end Lift

end TL

section JonesWenzl

open Ring

variable {R A : Type*} [CommRing R] [Ring A] [Algebra R A]

/-- The Jones–Wenzl element on three strands, `f = 1 - (δ / (δ² - 1)) (x + y) +
(1 / (δ² - 1)) (x y + y x)` for generators `x = e_i`, `y = e_(i+1)`
(`results/presentation-consequences-extend.md` Theorem B.1, 3ba2201). It is the Jones–Wenzl
idempotent when `δ² - 1` is a unit. -/
noncomputable def jw (δ : R) (x y : A) : A :=
  1 - (δ * (δ ^ 2 - 1)⁻¹ʳ) • (x + y) + (δ ^ 2 - 1)⁻¹ʳ • (x * y + y * x)

/-- `f` is symmetric in the two generators. -/
theorem jw_comm (δ : R) (x y : A) : jw δ x y = jw δ y x := by
  rw [jw, jw, add_comm x y, add_comm (x * y)]

variable {δ : R} {x y : A}

/-- `x f = 0` from `x² = δ x` and `x y x = x` (Theorem B.1). -/
theorem mul_jw (hδ : IsUnit (δ ^ 2 - 1)) (hx : x * x = δ • x) (hxyx : x * y * x = x) :
    x * jw δ x y = 0 := by
  have hc := inverse_mul_cancel _ hδ
  simp only [jw, mul_add, mul_sub, mul_one, mul_smul_comm, ← mul_assoc, hx, hxyx,
    smul_mul_assoc]
  linear_combination (norm := module) (-hc) • x

/-- `f x = 0` from `x² = δ x` and `x y x = x` (Theorem B.1). -/
theorem jw_mul (hδ : IsUnit (δ ^ 2 - 1)) (hx : x * x = δ • x) (hxyx : x * y * x = x) :
    jw δ x y * x = 0 := by
  have hc := inverse_mul_cancel _ hδ
  have hyxx : y * x * x = δ • (y * x) := by rw [mul_assoc, hx, mul_smul_comm]
  simp only [jw, add_mul, sub_mul, one_mul, smul_mul_assoc, hx, hyxx, hxyx]
  linear_combination (norm := module) (-hc) • x

/-- `f² = f`, since `f - 1` lies in the right ideal of `x` and `y` and `f x = f y = 0`
(Theorem B.1). -/
theorem jw_mul_self (hδ : IsUnit (δ ^ 2 - 1)) (hx : x * x = δ • x) (hy : y * y = δ • y)
    (hxyx : x * y * x = x) (hyxy : y * x * y = y) : jw δ x y * jw δ x y = jw δ x y := by
  have h1 := jw_mul hδ hx hxyx
  have h2 : jw δ x y * y = 0 := by rw [jw_comm]; exact jw_mul hδ hy hyxy
  conv_lhs => arg 2; rw [jw]
  simp only [mul_add, mul_sub, mul_one, mul_smul_comm, ← mul_assoc, h1, h2, zero_mul, add_zero,
    smul_zero, sub_zero]

/-- At `δ = -2`, `1 + (1 + x)(1 + y) + (1 + y)(1 + x) = 3 f` whenever `3` is a unit. This is
pure expansion and uses no relation (Theorem B.1, with the `ℤ[1/3]` reading of fact check item 8).
-/
theorem one_add_mul_add_mul_eq_three_smul_jw (h3 : IsUnit (3 : R)) (x y : A) :
    1 + (1 + x) * (1 + y) + (1 + y) * (1 + x) = (3 : R) • jw (-2 : R) x y := by
  have h : ((-2 : R) ^ 2 - 1) = 3 := by norm_num
  have hc := mul_inverse_cancel _ h3
  rw [jw, h]
  simp only [mul_add, add_mul, mul_one, one_mul]
  linear_combination (norm := module) (-hc) • ((2 : R) • (x + y) + (x * y + y * x))

end JonesWenzl

/-- Over `𝔽₂`, `(0² - 1)⁻¹ = 1`. -/
theorem inverse_neg_one_F₂ : Ring.inverse ((0 : F₂) ^ 2 - 1) = 1 := by
  rw [show ((0 : F₂) ^ 2 - 1) = 1 by decide, Ring.inverse_one]

/-- Over `𝔽₂` at `δ = 0`, `f = 1 + x y + y x` (Theorem B.1). -/
theorem jw_zero_F₂ {A : Type*} [Ring A] [Algebra F₂ A] (x y : A) :
    jw (0 : F₂) x y = 1 + x * y + y * x := by
  rw [jw, inverse_neg_one_F₂, zero_mul, zero_smul, sub_zero, one_smul, add_assoc]

namespace TL

variable {R : Type*} [CommRing R] {N : ℕ} {δ : R}

section Translate

variable {i j : Fin (N - 1)} (h : (j : ℕ) = i + 1 ∨ (i : ℕ) = j + 1)

include h

/-- `e_i f = 0` for the Jones–Wenzl element on adjacent generators `e_i, e_j`
(Theorem B.1). -/
theorem e_mul_jw (hδ : IsUnit (δ ^ 2 - 1)) : e R N δ i * jw δ (e R N δ i) (e R N δ j) = 0 :=
  mul_jw hδ (e_mul_self i) (e_mul_e_mul_e h)

/-- `f e_i = 0` (Theorem B.1). -/
theorem jw_mul_e (hδ : IsUnit (δ ^ 2 - 1)) : jw δ (e R N δ i) (e R N δ j) * e R N δ i = 0 :=
  jw_mul hδ (e_mul_self i) (e_mul_e_mul_e h)

/-- `e_j f = 0` (Theorem B.1). -/
theorem e_mul_jw' (hδ : IsUnit (δ ^ 2 - 1)) : e R N δ j * jw δ (e R N δ i) (e R N δ j) = 0 := by
  rw [jw_comm]
  exact mul_jw hδ (e_mul_self j) (e_mul_e_mul_e h.symm)

/-- `f e_j = 0` (Theorem B.1). -/
theorem jw_mul_e' (hδ : IsUnit (δ ^ 2 - 1)) : jw δ (e R N δ i) (e R N δ j) * e R N δ j = 0 := by
  rw [jw_comm]
  exact jw_mul hδ (e_mul_self j) (e_mul_e_mul_e h.symm)

/-- `f² = f` (Theorem B.1). -/
theorem jw_e_mul_self (hδ : IsUnit (δ ^ 2 - 1)) :
    jw δ (e R N δ i) (e R N δ j) * jw δ (e R N δ i) (e R N δ j) = jw δ (e R N δ i) (e R N δ j) :=
  jw_mul_self hδ (e_mul_self i) (e_mul_self j) (e_mul_e_mul_e h) (e_mul_e_mul_e h.symm)

end Translate

section Three

variable (R δ) in
/-- The Jones–Wenzl idempotent `f_3` of `TL_3(δ)`, on the generators `e_1 = e 0`, `e_2 = e 1`
(`results/presentation-consequences-extend.md` Theorem B.1, 3ba2201). -/
noncomputable def f3 : TL R 3 δ :=
  jw δ (e R 3 δ 0) (e R 3 δ 1)

/-- The two generators `e_1 = e 0` and `e_2 = e 1` of `TL_3` are adjacent. -/
theorem adj_zero_one : ((1 : Fin (3 - 1)) : ℕ) = (0 : Fin (3 - 1)) + 1 ∨
    ((0 : Fin (3 - 1)) : ℕ) = (1 : Fin (3 - 1)) + 1 :=
  Or.inl rfl

/-- **Theorem B.1, annihilation.** In `TL_3(δ)` with `δ² - 1` a unit,
`e_1 f_3 = f_3 e_1 = e_2 f_3 = f_3 e_2 = 0` (`results/presentation-consequences-extend.md`
§3.1, 3ba2201). -/
theorem e_mul_f3_and (hδ : IsUnit (δ ^ 2 - 1)) :
    e R 3 δ 0 * f3 R δ = 0 ∧ f3 R δ * e R 3 δ 0 = 0 ∧ e R 3 δ 1 * f3 R δ = 0 ∧
      f3 R δ * e R 3 δ 1 = 0 :=
  ⟨e_mul_jw adj_zero_one hδ, jw_mul_e adj_zero_one hδ, e_mul_jw' adj_zero_one hδ,
    jw_mul_e' adj_zero_one hδ⟩

/-- **Theorem B.1, idempotence.** `f_3² = f_3` in `TL_3(δ)` when `δ² - 1` is a unit
(`results/presentation-consequences-extend.md` §3.1, 3ba2201). -/
theorem f3_mul_self (hδ : IsUnit (δ ^ 2 - 1)) : f3 R δ * f3 R δ = f3 R δ :=
  jw_e_mul_self adj_zero_one hδ

/-- **Theorem B.1, the three-cycle element.** At `δ = -2`, over any ring where `3` is a unit,
`1 + s_1 s_2 + s_2 s_1 = 3 f_3` with `s_i = 1 + e_i`, the `A = 1` crossing of
`results/tl-jantzen-extend.md` steps 1 and 1b (b21b41a). Over `ℤ` this holds in `TL ⊗ ℤ[1/3]`,
as fact check item 8 of `results/presentation-consequences-factcheck-extend.md` (3ba2201)
corrects. -/
theorem one_add_s_mul_s_add_s_mul_s (h3 : IsUnit (3 : R)) :
    1 + (1 + e R 3 (-2) 0) * (1 + e R 3 (-2) 1) + (1 + e R 3 (-2) 1) * (1 + e R 3 (-2) 0) =
      (3 : R) • f3 R (-2) :=
  one_add_mul_add_mul_eq_three_smul_jw h3 _ _

/-- **Theorem B.1 over `𝔽₂`.** At `δ = 0`, `f_3 = 1 + e_1 e_2 + e_2 e_1`
(`results/presentation-consequences-extend.md` §3.1, 3ba2201). -/
theorem f3_F₂ : f3 F₂ 0 = 1 + e F₂ 3 0 0 * e F₂ 3 0 1 + e F₂ 3 0 1 * e F₂ 3 0 0 :=
  jw_zero_F₂ _ _

end Three

end TL

section CharTwo

variable {A : Type*} [Ring A] [Algebra F₂ A] {x y : A}

/-- In characteristic `2`, `(1 + x)² = 1` when `x² = 0`. -/
theorem one_add_mul_one_add_F₂ (hx : x * x = 0) : (1 + x) * (1 + x) = 1 := by
  calc (1 + x) * (1 + x) = 1 + (x + x) + x * x := by noncomm_ring
    _ = 1 := by rw [add_self_F₂, hx, add_zero, add_zero]

/-- In characteristic `2`, `{1 + x, 1 + y} = x y + y x`. -/
theorem one_add_mul_one_add_add_F₂ (x y : A) :
    (1 + x) * (1 + y) + (1 + y) * (1 + x) = x * y + y * x := by
  calc (1 + x) * (1 + y) + (1 + y) * (1 + x) = (1 + 1) + (x + x) + (y + y) + (x * y + y * x) := by
        noncomm_ring
    _ = x * y + y * x := by simp only [add_self_F₂, zero_add]

/-- In characteristic `2`, `1 + (1 + x) = x`. -/
theorem one_add_one_add_F₂ (x : A) : 1 + (1 + x) = x := by
  rw [← add_assoc, add_self_F₂, zero_add]

/-- In characteristic `2`, `x + y = 0` gives `x = y`. -/
theorem eq_of_add_eq_zero_F₂ (h : x + y = 0) : x = y := by
  rw [← sub_eq_zero, sub_eq_add_neg, neg_eq_self_F₂, h]

/-- The `δ = 0` braid relation of `1 + a`, `1 + b` from the Clifford relations `a² = 1` and
`a b + b a = 1` in characteristic `2` (Theorem B.2). -/
theorem one_add_mul_mul_one_add_F₂ (haa : x * x = 1) (hab : x * y + y * x = 1) :
    (1 + x) * (1 + y) * (1 + x) = 1 + x := by
  have hba : y * x = 1 + x * y := by
    rw [← hab, add_comm (x * y), add_assoc, add_self_F₂, add_zero]
  have haba : x * (y * x) = x + y := by
    rw [hba, mul_add, mul_one, ← mul_assoc, haa, one_mul]
  calc (1 + x) * (1 + y) * (1 + x) = 1 + (x + x) + y + (x * y + y * x) + x * x + x * (y * x) := by
        noncomm_ring
    _ = 1 + x + (1 + 1) + (y + y) := by rw [hab, haa, haba, add_self_F₂]; abel
    _ = 1 + x := by rw [add_self_F₂, add_self_F₂, add_zero, add_zero]

end CharTwo

/-- An algebra map carries the Jones–Wenzl element of `x, y` to that of their images. -/
theorem map_jw {R A B : Type*} [CommRing R] [Ring A] [Algebra R A] [Ring B] [Algebra R B]
    (g : A →ₐ[R] B) (δ : R) (x y : A) : g (jw δ x y) = jw δ (g x) (g y) := by
  simp only [jw, map_add, map_sub, map_smul, map_mul, map_one]

namespace TL

variable (n : ℕ)

/-- The relations `f_3^(i) = 0` on `TL_2n(0)` over `𝔽₂`, one for each translate of `f_3` to the
adjacent generators `e_i, e_(i+1)` (`results/presentation-consequences-extend.md` Theorem B.2,
3ba2201). -/
inductive JWRel : TL F₂ (2 * n) 0 → TL F₂ (2 * n) 0 → Prop
  | mk (i j : Fin (2 * n - 1)) (h : (j : ℕ) = i + 1) :
      JWRel (jw (0 : F₂) (e F₂ (2 * n) 0 i) (e F₂ (2 * n) 0 j)) 0

end TL

/-- `TL_2n(0) ⧸ ⟨f_3^(i)⟩` over `𝔽₂`, the quotient by every translate of the Jones–Wenzl element
(`results/presentation-consequences-extend.md` Theorem B.2, 3ba2201). -/
def TLJW (n : ℕ) : Type :=
  (ringConGen (TL.JWRel n)).Quotient

namespace TLJW

variable {n : ℕ}

/-- The ring structure of `TL_2n(0) ⧸ ⟨f_3^(i)⟩`, from the quotient. -/
instance : Ring (TLJW n) :=
  inferInstanceAs (Ring (RingCon.Quotient _))

/-- The `𝔽₂`-algebra structure of `TL_2n(0) ⧸ ⟨f_3^(i)⟩`, from the quotient. -/
instance : Algebra F₂ (TLJW n) :=
  inferInstanceAs (Algebra F₂ (RingCon.Quotient _))

variable (n) in
/-- The quotient map `TL_2n(0) → TL_2n(0) ⧸ ⟨f_3^(i)⟩`. -/
def mk : TL F₂ (2 * n) 0 →ₐ[F₂] TLJW n :=
  RingCon.mkₐ F₂ (ringConGen (TL.JWRel n))

/-- `mk` kills every translate `f_3^(i)`. -/
theorem mk_jw {i j : Fin (2 * n - 1)} (h : (j : ℕ) = i + 1) :
    mk n (jw (0 : F₂) (TL.e F₂ (2 * n) 0 i) (TL.e F₂ (2 * n) 0 j)) = 0 :=
  ((RingCon.eq _).mpr (RingCon.le_ringConGen _ _ (TL.JWRel.mk i j h))).trans (map_zero (mk n))

/-- The quotient map `TL_2n(0) → TL_2n(0) ⧸ ⟨f_3^(i)⟩` is onto. -/
theorem mk_surjective : Function.Surjective (mk n) :=
  RingCon.mkₐ_surjective _

/-- The universal property of the quotient: an algebra map out of `TL_2n(0)` that kills every
`f_3^(i)` factors through `TL_2n(0) ⧸ ⟨f_3^(i)⟩`. -/
def lift {A : Type*} [Ring A] [Algebra F₂ A] (g : TL F₂ (2 * n) 0 →ₐ[F₂] A)
    (hg : ∀ i j : Fin (2 * n - 1), (j : ℕ) = i + 1 →
      g (jw (0 : F₂) (TL.e F₂ (2 * n) 0 i) (TL.e F₂ (2 * n) 0 j)) = 0) : TLJW n →ₐ[F₂] A :=
  RingCon.liftₐ _ g (RingCon.ringConGen_le.2 fun _ _ h ↦ by
    rw [RingCon.ker_apply]
    induction h with
    | mk i j h => exact (hg i j h).trans (map_zero g).symm)

/-- `lift g` restricts to `g` on `TL_2n(0)`. -/
theorem lift_mk {A : Type*} [Ring A] [Algebra F₂ A] (g : TL F₂ (2 * n) 0 →ₐ[F₂] A) (hg)
    (x : TL F₂ (2 * n) 0) : lift g hg (mk n x) = g x :=
  rfl

variable (n) in
/-- The image `ē_i` of `e_i` in `TL_2n(0) ⧸ ⟨f_3^(i)⟩`. -/
def ebar (i : Fin (2 * n - 1)) : TLJW n :=
  mk n (TL.e F₂ (2 * n) 0 i)

/-- Two algebra maps out of `TL_2n(0) ⧸ ⟨f_3^(i)⟩` that agree on every `ē_i` are equal. -/
theorem hom_ext {A : Type*} [Ring A] [Algebra F₂ A] {g g' : TLJW n →ₐ[F₂] A}
    (h : ∀ i, g (ebar n i) = g' (ebar n i)) : g = g' :=
  RingCon.Quotient.hom_extₐ (TL.hom_ext h)

/-- `ē_i² = 0`, the relation `e_i² = δ e_i` at `δ = 0`. -/
theorem ebar_mul_self (i : Fin (2 * n - 1)) : ebar n i * ebar n i = 0 := by
  rw [ebar, ← map_mul, TL.e_mul_self, zero_smul, map_zero]

/-- `ē_i ē_j = ē_j ē_i` for `|i - j| ≥ 2`. -/
theorem ebar_mul_ebar_comm {i j : Fin (2 * n - 1)} (h : (i : ℕ) + 2 ≤ j ∨ (j : ℕ) + 2 ≤ i) :
    ebar n i * ebar n j = ebar n j * ebar n i := by
  rw [ebar, ebar, ← map_mul, ← map_mul, TL.e_mul_e_comm h]

/-- `ē_i ē_(i+1) + ē_(i+1) ē_i = 1` modulo `f_3^(i) = 1 + e_i e_(i+1) + e_(i+1) e_i`. -/
theorem ebar_anticomm {i j : Fin (2 * n - 1)} (h : (j : ℕ) = i + 1) :
    ebar n i * ebar n j + ebar n j * ebar n i = 1 := by
  have hr := mk_jw h
  rw [map_jw, jw_zero_F₂, add_assoc] at hr
  exact (eq_of_add_eq_zero_F₂ hr).symm

/-- The anticommutator of `1 + ē_s` and `1 + ē_t` is `[|s - t| = 1]`. -/
theorem one_add_ebar_anticomm (s t : Fin (2 * n - 1)) :
    (1 + ebar n s) * (1 + ebar n t) + (1 + ebar n t) * (1 + ebar n s) =
      if (t : ℕ) = s + 1 ∨ (s : ℕ) = t + 1 then 1 else 0 := by
  rw [one_add_mul_one_add_add_F₂]
  split_ifs with h
  · rcases h with h | h
    · exact ebar_anticomm h
    · rw [add_comm]
      exact ebar_anticomm h
  · by_cases hst : s = t
    · subst hst
      exact add_self_F₂ _
    · have hst' : (s : ℕ) ≠ t := fun h' ↦ hst (Fin.ext h')
      rw [ebar_mul_ebar_comm (by omega)]
      exact add_self_F₂ _

variable (n) in
/-- `Cl(U_n, q) → TL_2n(0) ⧸ ⟨f_3^(i)⟩`, `ι(v_{t,t+1}) ↦ 1 + e_t`, from `reduceHom`
(`spin/Spin/Reduce.lean`, ham-spin 5ecf8a5). -/
noncomputable def clToTLJW (hn : 1 ≤ n) : Cl n →ₐ[F₂] TLJW n :=
  reduceHom hn (fun t ↦ 1 + ebar n t) (fun t ↦ one_add_mul_one_add_F₂ (ebar_mul_self t))
    one_add_ebar_anticomm

/-- `clToTLJW` sends `ι(v_{t,t+1})` to `1 + ē_t`. -/
theorem clToTLJW_ι (hn : 1 ≤ n) (t : Fin (2 * n - 1)) :
    clToTLJW n hn (CliffordAlgebra.ι _ (adjU n t)) = 1 + ebar n t :=
  reduceHom_ι_adjU hn _ _ _ t

/-- `{T_s, T_t} = 1` in `Cl(U_n, q)` for `|s - t| = 1`. -/
theorem adjT_anticomm_of_adj {s t : Fin (2 * n - 1)} (h : (t : ℕ) = s + 1 ∨ (s : ℕ) = t + 1) :
    adjT n s * adjT n t + adjT n t * adjT n s = 1 := by
  simp [adjT_anticomm, h]

/-- `T_t² = 1` in `Cl(U_n, q)`, as `q(v_{t,t+1}) = 1` and `-1 = 1`. -/
theorem adjT_mul_self (t : Fin (2 * n - 1)) : adjT n t * adjT n t = 1 := by
  rw [adjT_sq, neg_eq_self_F₂]

/-- `T_s T_t = T_t T_s` in `Cl(U_n, q)` for `|s - t| ≥ 2`. -/
theorem adjT_mul_comm {s t : Fin (2 * n - 1)} (h : (s : ℕ) + 2 ≤ t) :
    adjT n s * adjT n t = adjT n t * adjT n s := by
  apply eq_of_add_eq_zero_F₂
  rw [adjT_anticomm]
  simp only [ite_eq_right_iff]
  omega

variable (n) in
/-- `TL_2n(0) → Cl(U_n, q)`, `e_t ↦ 1 + ι(v_{t,t+1})`. The Temperley–Lieb relations at `δ = 0`
are `(1 + a)² = 0`, `(1 + a)(1 + b)(1 + a) = 1 + a` and far commutation. -/
noncomputable def tlToCl : TL F₂ (2 * n) 0 →ₐ[F₂] Cl n :=
  TL.lift (fun t ↦ 1 + adjT n t)
    (fun t ↦ by
      rw [zero_smul, ← add_self_F₂ (1 : Cl n)]
      calc (1 + adjT n t) * (1 + adjT n t) = 1 + (adjT n t + adjT n t) + adjT n t * adjT n t := by
            noncomm_ring
        _ = 1 + 1 := by rw [add_self_F₂, adjT_mul_self, add_zero])
    (fun _ _ h ↦ one_add_mul_mul_one_add_F₂ (adjT_mul_self _) (adjT_anticomm_of_adj h))
    (fun s t h ↦ by
      calc (1 + adjT n s) * (1 + adjT n t) = 1 + adjT n s + adjT n t + adjT n s * adjT n t := by
            noncomm_ring
        _ = 1 + adjT n t + adjT n s + adjT n t * adjT n s := by rw [adjT_mul_comm h]; abel
        _ = (1 + adjT n t) * (1 + adjT n s) := by noncomm_ring)

/-- `tlToCl` sends `e_t` to `1 + ι(v_{t,t+1})`. -/
theorem tlToCl_e (t : Fin (2 * n - 1)) : tlToCl n (TL.e F₂ (2 * n) 0 t) = 1 + adjT n t :=
  TL.lift_e _ _ _ _ t

/-- `tlToCl` kills every translate `f_3^(i) = 1 + e_i e_(i+1) + e_(i+1) e_i`. -/
theorem tlToCl_jw {i j : Fin (2 * n - 1)} (h : (j : ℕ) = i + 1) :
    tlToCl n (jw (0 : F₂) (TL.e F₂ (2 * n) 0 i) (TL.e F₂ (2 * n) 0 j)) = 0 := by
  rw [map_jw, tlToCl_e, tlToCl_e, jw_zero_F₂, add_assoc, one_add_mul_one_add_add_F₂,
    adjT_anticomm_of_adj (Or.inl h), add_self_F₂]

variable (n) in
/-- `TL_2n(0) ⧸ ⟨f_3^(i)⟩ → Cl(U_n, q)`, `ē_t ↦ 1 + ι(v_{t,t+1})`. -/
noncomputable def tlJWToCl : TLJW n →ₐ[F₂] Cl n :=
  lift (tlToCl n) fun _ _ h ↦ tlToCl_jw h

/-- `tlJWToCl` sends `ē_t` to `1 + ι(v_{t,t+1})`. -/
theorem tlJWToCl_ebar (t : Fin (2 * n - 1)) : tlJWToCl n (ebar n t) = 1 + adjT n t := by
  rw [tlJWToCl, ebar, lift_mk, tlToCl_e]

/-- **Theorem B.2.** Over `𝔽₂`, `TL_2n(0) ⧸ ⟨f_3^(i)⟩ ≅ Cl(U_n, q)` by `e_i ↦ 1 + ι(v_i)` with
`v_i = ε_i + ε_(i+1)` (`results/presentation-consequences-extend.md` §3.1, 3ba2201, verified in
item 9 of `results/presentation-consequences-factcheck-extend.md`, 3ba2201). Both maps come from
universal properties, `TL.lift` with `RingQuot.liftAlgHom` one way and `reduceHom` the other, and
they are inverse on generators. -/
noncomputable def jwQuotEquivCl (hn : 1 ≤ n) : TLJW n ≃ₐ[F₂] Cl n :=
  AlgEquiv.ofAlgHom (tlJWToCl n) (clToTLJW n hn)
    (CliffordAlgebra.hom_ext (LinearMap.ext_on_range (span_adjU n hn) fun t ↦ by
      simp only [LinearMap.comp_apply, AlgHom.toLinearMap_apply, AlgHom.comp_apply,
        AlgHom.coe_id, id_eq]
      rw [clToTLJW_ι, map_add, map_one, tlJWToCl_ebar, one_add_one_add_F₂, adjT]))
    (hom_ext fun t ↦ by
      rw [AlgHom.comp_apply, AlgHom.id_apply, tlJWToCl_ebar, map_add, map_one, adjT, clToTLJW_ι,
        one_add_one_add_F₂])

/-- `jwQuotEquivCl` sends `ē_i` to `1 + ι(v_{i,i+1})` (Theorem B.2). -/
theorem jwQuotEquivCl_ebar (hn : 1 ≤ n) (t : Fin (2 * n - 1)) :
    jwQuotEquivCl hn (ebar n t) = 1 + CliffordAlgebra.ι _ (adjU n t) :=
  tlJWToCl_ebar t

/-- The inverse of `jwQuotEquivCl` sends `ι(v_{i,i+1})` to `1 + ē_i` (Theorem B.2). -/
theorem jwQuotEquivCl_symm_ι (hn : 1 ≤ n) (t : Fin (2 * n - 1)) :
    (jwQuotEquivCl hn).symm (CliffordAlgebra.ι _ (adjU n t)) = 1 + ebar n t :=
  clToTLJW_ι hn t

end TLJW

